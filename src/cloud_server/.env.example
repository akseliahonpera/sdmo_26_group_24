# Copy this file to ".env" and change the passwords:
#   cp .env.example .env          (macOS/Linux/Git Bash)
#   copy .env.example .env        (Windows cmd)
#
# Tip: stick to letters, numbers, "_" and "-" in passwords. Characters like
# "$" or "#" get interpreted by docker compose and can break the value.

# --- Used by the MySQL container (first startup only) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=cloud_db
MYSQL_USER=cloud_user
MYSQL_PASSWORD=change_me

# --- Used by the Flask app to connect ---
MYSQL_HOST=127.0.0.1
# Also the host port Docker publishes. Change it (e.g. 3307) if you already
# have a MySQL running locally on 3306.
MYSQL_PORT=3306
